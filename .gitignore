# =====================================================================
# Unified .gitignore for the whole APSD_TAI_LAB repository
# (covers both APDS/ and TAI/ coursework tracks).
# =====================================================================

# --- Python bytecode & packaging ------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# --- Test & lint caches ----------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/

# --- Virtual environments --------------------------------------------
.venv/
venv/
env/
ENV/

# --- IDE folders ------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# --- Jupyter ----------------------------------------------------------
.ipynb_checkpoints/
.jupyter/
*.ipynb_meta

# --- Environment variables & secrets ----------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs --------------------------------------------------------------
*.log

# --- OS files -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- TAI runtime generated outputs -------------------------------------
# (Notebooks write their generated images here; they are never committed.
# The .gitkeep exception keeps the directory itself tracked so a fresh
# clone has the output root that TAI.utils.env_io.bootstrap() expects.)
TAI/outputs/*
!TAI/outputs/.gitkeep

# --- APDS generated data / benchmark artifacts --------------------------
APDS/02_Sales_Inventory_Pipeline/data/processed/*
!APDS/02_Sales_Inventory_Pipeline/data/processed/.gitkeep
APDS/04_One_Million_Record_Streaming/large_patients.csv
APDS/04_One_Million_Record_Streaming/large_products.csv
APDS/07_Monthly_Sales_Forecasting/data/
